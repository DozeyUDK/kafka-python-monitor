# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPICS=test-topic
KAFKA_GROUP_ID=kafka-monitor-group
# earliest replays retained messages only when group has no committed offsets.
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_BATCH_SIZE=100
MONITOR_INTERVAL_SECONDS=1
METRICS_INTERVAL_SECONDS=30
KAFKA_MAX_RETRIES=5
KAFKA_RETRY_BACKOFF_MS=1000
KAFKA_RECONNECT_INTERVAL_SECONDS=5
USE_BATCH_PROCESSING=false

# Security (PLAINTEXT for trusted development networks only)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SSL_CAFILE=/run/secrets/kafka-ca.pem
# KAFKA_SSL_CERTFILE=/run/secrets/kafka-client.pem
# KAFKA_SSL_KEYFILE=/run/secrets/kafka-key.pem
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=monitor
# KAFKA_SASL_PASSWORD=replace-me

# Failed custom callbacks: DLQ is optional; Kafka publishing is acknowledged.
KAFKA_DLQ_ENABLED=false
KAFKA_DLQ_TOPIC=kafka-monitor-dlq

# HTTP. Protect this endpoint at network level; it has no authentication.
LOG_LEVEL=INFO
HEALTH_CHECK_PORT=8080
HEALTH_SERVER_HOST=127.0.0.1

# Elasticsearch. Enable this to forward actual Kafka messages.
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USE_SSL=false
ELASTICSEARCH_VERIFY_CERTS=true
# ELASTICSEARCH_USERNAME=monitor
# ELASTICSEARCH_PASSWORD=replace-me
# ELASTICSEARCH_API_KEY=replace-me
# ELASTICSEARCH_CA_CERTS=/run/secrets/elastic-ca.pem
ELASTICSEARCH_EVENTS_INDEX=kafka-events
ELASTICSEARCH_METRICS_INDEX=kafka-metrics
ELASTICSEARCH_INDEX_DATE_FORMAT=%Y.%m.%d
ELASTICSEARCH_BATCH_SIZE=100
