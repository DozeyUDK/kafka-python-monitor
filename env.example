# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPICS=test-topic
# Or use KAFKA_TOPIC for single topic (deprecated, use KAFKA_TOPICS)
# KAFKA_TOPIC=test-topic
KAFKA_GROUP_ID=kafka-monitor-group
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_CONSUMER_TIMEOUT_MS=5000

# Retry Configuration
KAFKA_MAX_RETRIES=5
KAFKA_RETRY_BACKOFF_MS=1000
KAFKA_RECONNECT_INTERVAL_SECONDS=5

# Batch Processing
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_TIMEOUT_MS=5000
USE_BATCH_PROCESSING=false

# SSL/SASL Configuration
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Options: PLAINTEXT, SSL, SASL_PLAINTEXT, SASL_SSL

# SSL Configuration (if using SSL)
# KAFKA_SSL_CAFILE=/path/to/ca-cert
# KAFKA_SSL_CERTFILE=/path/to/client-cert
# KAFKA_SSL_KEYFILE=/path/to/client-key

# SASL Configuration (if using SASL)
# KAFKA_SASL_MECHANISM=PLAIN
# Options: PLAIN, SCRAM-SHA-256, SCRAM-SHA-512
# KAFKA_SASL_USERNAME=your-username
# KAFKA_SASL_PASSWORD=your-password

# Dead Letter Queue
KAFKA_DLQ_ENABLED=false
KAFKA_DLQ_TOPIC=test-topic-dlq

# Monitor Configuration
LOG_LEVEL=INFO
MONITOR_INTERVAL_SECONDS=5

# Health Check Server
HEALTH_CHECK_PORT=8080
# Set to 0 to disable health check server (default: 8080)

# Elasticsearch Configuration
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_HOSTS=localhost:9200
ELASTICSEARCH_USE_SSL=false
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_EVENTS_INDEX=kafka-events
ELASTICSEARCH_METRICS_INDEX=kafka-metrics
ELASTICSEARCH_INDEX_DATE_FORMAT=%Y.%m.%d
ELASTICSEARCH_BATCH_SIZE=100
ELASTICSEARCH_BATCH_TIMEOUT_SECONDS=10
